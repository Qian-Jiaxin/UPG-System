`timescale 1 ps/ 1 ps
`define clk_period 5000
module UsartRx_Stream_tb();

reg clk;
reg rst_n;
reg rx;
// wires                                               
wire [7:0]  temperature;
wire [7:0]	busvoltage;
wire cellstatus;
wire done;
                       
UsartRx_Stream #(.COMMUNICATION_ERROR_CODE(8'hFF), .HEAD0(8'hAB), .HEAD1(8'hBA)) usartrx_inst(
	.clk(clk),
	.rst_n(rst_n),
	.usart_rx(rx),
	.temperature(temperature),
	.busvoltage(busvoltage),
	.cellstatus(cellstatus),
	.done(done)
);


initial                                                
begin      
	clk = 0;
	forever
		#(`clk_period/2)
		clk = ~clk;                                                      
end

initial 
begin
	rst_n = 1;
	rx = 1;
	#(1*`clk_period) rst_n = 0;
	#(5*`clk_period) rst_n = 1; 
	#(1*`clk_period)
	rx  =1;
	#(1*`clk_period)

	//BA
	rx = 0;  //start
	#(20833*`clk_period)
	rx = 0;
	#(20833*`clk_period)
	rx = 1;
	#(20833*`clk_period)
	rx = 0;
	#(20833*`clk_period)
	rx = 1;
	#(20833*`clk_period)
	rx = 1;
	#(20833*`clk_period)
	rx = 1;
	#(20833*`clk_period)
	rx = 0;
	#(20833*`clk_period)
	rx = 1;
	#(20833*`clk_period)
	rx = 1;  //stop
	#(20833*`clk_period)

	//AB
	rx = 0;  //start
	#(20833*`clk_period)
	rx = 1;
	#(20833*`clk_period)
	rx = 1;
	#(20833*`clk_period)
	rx = 0;
