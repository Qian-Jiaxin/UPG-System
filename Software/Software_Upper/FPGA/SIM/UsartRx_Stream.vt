	#(20833*`clk_period)
	rx = 0;
	#(20833*`clk_period)
	rx = 1;  //stop
	#(20833*`clk_period)

	//CRC 69
	rx = 0;	 //start
	#(20833*`clk_period)
	rx = 1;
	#(20833*`clk_period)
	rx = 0;
	#(20833*`clk_period)
	rx = 0;
	#(20833*`clk_period)
