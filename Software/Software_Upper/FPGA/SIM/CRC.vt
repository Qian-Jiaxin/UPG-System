`timescale 1 ps/ 1 ps
`define clk_period 5000

module CRC_tb();

localparam BYTESNUM = 28;
localparam DATA_WIDTH = 8;

reg clk;
reg rst_n;
reg crc_cs_n;
wire [BYTESNUM*DATA_WIDTH-1:0] data_in;
reg [7:0] data0, data1, data2, data3;
// wires                                               
wire [7:0]  data_out;
wire crc_done;
                       
CRC #(.BYTES(BYTESNUM), .DATA_WIDTH(DATA_WIDTH)) crc_inst(
    .clk(clk),
    .rst_n(rst_n),
    .crc_cs_n(crc_cs_n),
    .data_in(data_in),
    .data_out(data_out),
    .crc_done(crc_done)
);

assign data_in = {data0,data1,data2,data3,data0,data1,data2,data3,data0,data1,data2,data3,data0,data1,data2,data3,data0,data1,data2,data3,data0,data1,data2,data3,data3,data1,data2,data0};

initial                                                
begin      
	clk = 0;
	forever
		#(`clk_period/2)
		clk = ~clk;                                                      
end

initial 
begin
	rst_n = 1;
	crc_cs_n = 1;
	data0 = 8'h00;
	data1 = 8'h00;
	data2 = 8'h00;
	data3 = 8'h00;
	#(1*`clk_period) rst_n = 0;
	#(5*`clk_period) rst_n = 1; 
	#(1*`clk_period)
	data0 = 8'hFF;
	data1 = 8'h0A;
	data2 = 8'hA0;
	data3 = 8'hF0;
	#(1*`clk_period)
	crc_cs_n = 0;
	#(1*`clk_period)
	crc_cs_n = 1;
	#(250*`clk_period)

	data0 = 8'h0A;
	data1 = 8'hF0;
	data2 = 8'h0B;
	data3 = 8'hA0;
	#(1*`clk_period)
	crc_cs_n = 0;
	#(1*`clk_period)
	crc_cs_n = 1;
	#(250*`clk_period)

	$stop;

end
                                                  
endmodule

