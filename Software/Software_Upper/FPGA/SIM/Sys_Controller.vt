`timescale 1 ps/ 1 ps
`define clk_period 5000
module Sys_Controller_tb();

reg clk;
reg rst_n;
reg st_trigger_n;
reg  [27:0] usart_rx_bus;
reg st_cs_n;
reg st_rden_n;
reg st_wren_n;
reg [6:0] st_address;
reg [7:0] st_data_in;
// wires                                               
wire [27:0] pulse_out_bus;
wire [7:0] st_data_out;
wire st_waring;
                       
Sys_Controller#(.USART_ERROR_CODE(8'hFF), .USART_HEAD0(8'hAB), .USART_HEAD1(8'hBA), .ADDR_WIDTH(4'h07), .DATA_WIDTH(4'h08)) sys_controller_inst(
    .clk(clk),
    .rst_n(rst_n),

    .st_trigger_n(st_trigger_n),
    .usart_rx_bus(usart_rx_bus),
    .pulse_out_bus(pulse_out_bus),

    .st_cs_n(st_cs_n),
    .st_rden_n(st_rden_n),
    .st_wren_n(st_wren_n),
    .st_address(st_address),
    .st_data_in(st_data_in),
    .st_data_out(st_data_out),

    .st_waring(st_waring)
);

initial                                                
begin      
	clk = 0;
	forever
		#(`clk_period/2)
		clk = ~clk;                                                      
end

initial 
begin
	rst_n = 1;
	usart_rx_bus[0] = 1;
	usart_rx_bus[20] = 1;
	st_cs_n = 1'b1;
	st_rden_n = 1'b1;
	st_wren_n = 1'b1;
	st_address = 7'b0;
	#(1*`clk_period) rst_n = 0;
	#(5*`clk_period) rst_n = 1; 
	#(1*`clk_period)
	usart_rx_bus[0]  =1;
	usart_rx_bus[20]  =1;
	#(1*`clk_period)

	//BA
	usart_rx_bus[0] = 0;  //start
	#(20833*`clk_period)
	usart_rx_bus[0] = 0;
	#(20833*`clk_period)
	usart_rx_bus[0] = 1;
	#(20833*`clk_period)
	usart_rx_bus[0] = 0;
	#(20833*`clk_period)
