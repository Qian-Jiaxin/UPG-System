	#(303*`clk_period)
	st_cs_n = 1'b1;
	st_rden_n = 1'b1;

	// 0 sync 50ns
	#(5*`clk_period)
	st_cs_n = 1'b0;
	st_address = 7'h00;
	#(18*`clk_period)
	st_wren_n = 1'b0;
	st_data_in = 8'h0A;
	#(302*`clk_period)
	st_wren_n = 1'b1;
	#(1*`clk_period)
	st_cs_n = 1'b1;

	//crc sync
	#(5*`clk_period)
	st_cs_n = 1'b0;
	st_address = 7'h1C;
	#(18*`clk_period)
	st_wren_n = 1'b0;
	st_data_in = 8'h36;
	#(302*`clk_period)
	st_wren_n = 1'b1;
	#(1*`clk_period)
	st_cs_n = 1'b1;

	// pulse width 5us
	#(5*`clk_period)
	st_cs_n = 1'b0;
	st_address = 7'h1D;
	#(18*`clk_period)
	st_wren_n = 1'b0;
	st_data_in = 8'hE8;
	#(302*`clk_period)
	st_wren_n = 1'b1;
	#(1*`clk_period)
	st_cs_n = 1'b1;

