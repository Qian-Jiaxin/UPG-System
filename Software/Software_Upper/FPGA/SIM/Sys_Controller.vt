	#(20833*`clk_period)
	usart_rx_bus[0] = 1;  //stop
	#(20833*`clk_period)

	//A0
	usart_rx_bus[0] = 0;	 //start
	#(20833*`clk_period)
	usart_rx_bus[0] = 0;
	#(20833*`clk_period)
	usart_rx_bus[0] = 0;
	#(20833*`clk_period)
	usart_rx_bus[0] = 0;
	#(20833*`clk_period)
	usart_rx_bus[0] = 0;
	#(20833*`clk_period)
	usart_rx_bus[0] = 0;
	#(20833*`clk_period)
