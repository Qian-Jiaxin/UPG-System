	st_data_in = 8'h00;
	#(302*`clk_period)
	st_wren_n = 1'b1;
	#(1*`clk_period)
	st_cs_n = 1'b1;

	#(5*`clk_period)
	st_cs_n = 1'b0;
	st_address = 7'h20;
	#(18*`clk_period)
	st_wren_n = 1'b0;
	st_data_in = 8'h00;
	#(302*`clk_period)
	st_wren_n = 1'b1;
	#(1*`clk_period)
	st_cs_n = 1'b1;

	// pulse width sync
