	#(20833*`clk_period)
	usart_rx_bus[20] = 1;  //stop
	#(20833*`clk_period)

	#(5*`clk_period)

	st_cs_n = 1'b1;
	st_wren_n = 1'b1;
	st_rden_n = 1'b1;
	st_address = 7'b0;
	#(5*`clk_period)
	st_cs_n = 1'b0;
	st_address = 7'h30;
	#(18*`clk_period)
	st_rden_n = 1'b0;
	#(303*`clk_period)
	st_cs_n = 1'b1;
	st_rden_n = 1'b1;

	#(5*`clk_period)
	st_cs_n = 1'b0;
	st_address = 7'h44;
	#(18*`clk_period)
	st_rden_n = 1'b0;
	#(303*`clk_period)
	st_cs_n = 1'b1;
	st_rden_n = 1'b1;

	#(5*`clk_period)
