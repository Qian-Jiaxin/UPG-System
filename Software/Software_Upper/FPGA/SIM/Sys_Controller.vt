	#(20833*`clk_period)
	usart_rx_bus[0] = 1;  //stop
	#(20833*`clk_period)


	//AB
	usart_rx_bus[20] = 0;  //start
	#(20833*`clk_period)
	usart_rx_bus[20] = 1;
	#(20833*`clk_period)
	usart_rx_bus[20] = 1;
