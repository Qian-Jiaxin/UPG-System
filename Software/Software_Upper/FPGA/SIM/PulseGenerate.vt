`timescale 1 ps/ 1 ps
`define clk_period 5000
module PulseGenerate_tb();

reg clk;
reg rst_n;
reg st_trigger;
reg [31:0] pulsewidth;
reg [7:0] sync_delay;
// wires                                               
wire pulse_out;
                       

PulseGenerate#(.DATA_WIDTH(8)) pulsegenerator_inst(
	.clk(clk),
	.rst_n(rst_n),
	.st_trigger(st_trigger),
	.pulsewidth(pulsewidth),
	.sync_delay(sync_delay),
	.pulse_out(pulse_out)
);

initial                                                
begin      
	clk = 0;
	forever
		#(`clk_period/2)
		clk = ~clk;                                                      
end

initial 
begin
	rst_n = 1;
	st_trigger = 1;
	#(1*`clk_period) rst_n = 0;
	#(5*`clk_period) rst_n = 1; 

	#(1*`clk_period);
	pulsewidth = 32'd999;	//5us
	sync_delay = 8'd0;		//0ns
	#(1*`clk_period) st_trigger = ~st_trigger;
	#(1*`clk_period) st_trigger = ~st_trigger;

	#(2000*`clk_period);
	pulsewidth = 32'd999;	//5us
	sync_delay = 8'd199;	//1000ns
	#(1*`clk_period) st_trigger = ~st_trigger;
	#(1*`clk_period) st_trigger = ~st_trigger;

	#(2000*`clk_period);
	pulsewidth = 32'd1499;	//7.5us
	sync_delay = 8'd99;	//500ns
	#(1*`clk_period) st_trigger = ~st_trigger;
	#(1*`clk_period) st_trigger = ~st_trigger;

	#(2000*`clk_period);
	$stop;
end
                                                  
endmodule

